# Copia este archivo a .env y completa los valores. El .env real no se versiona.

# Base de datos MySQL (XAMPP): crea la base vacía y usa un usuario con permisos sobre ella.
DB_NAME=trainet
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Clave secreta de Django: genera una propia y no la compartas.
SECRET_KEY=cambia-esta-clave

# True solo en desarrollo.
DEBUG=True

# Solo en producción (en local se pueden omitir):
# Dominio(s) del sitio, separados por coma y sin https://
# ALLOWED_HOSTS=mi-sitio.serv00.net
# Orígenes permitidos para la API, con https://
# CORS_ALLOWED_ORIGINS=https://mi-sitio.serv00.net
# Para iniciar sesión en /admin/ por https
# CSRF_TRUSTED_ORIGINS=https://mi-sitio.serv00.net
# Carpeta con el frontend compilado (por defecto backend/frontend_dist)
# FRONTEND_DIR=/ruta/a/frontend_dist

# Contraseña de los usuarios de prueba que crea `python manage.py seed_trainet`. Solo para ese comando; no se usa en producción.
TRAINET_SEED_PASSWORD=cambia-esta-clave
