# Copia este archivo a .env y completa los valores. El .env real no se versiona.

# Base de datos MySQL (XAMPP): crea la base vacía y usa un usuario con permisos sobre ella.
DB_NAME=trainet
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Clave secreta de Django: genera una propia y no la compartas.
SECRET_KEY=cambia-esta-clave

# True solo en desarrollo.
DEBUG=True

# Contraseña de los usuarios de prueba que crea `python manage.py seed_trainet`. Solo para ese comando; no se usa en producción.
TRAINET_SEED_PASSWORD=cambia-esta-clave
